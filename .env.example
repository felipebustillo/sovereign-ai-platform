# Timezone (optional, defaults to UTC if unset)
TZ=UTC

# n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me
N8N_DB_NAME=n8n
N8N_ENCRYPTION_KEY=change-me

# Ollama (no native auth; protect via network or reverse proxy).
# Comma-separated list. First entry is the default; the rest are pulled too
# so they're ready when called. OLLAMA_MAX_LOADED_MODELS in compose caps
# how many stay in RAM concurrently (LRU eviction beyond that).
OLLAMA_LLM_MODELS=qwen2.5:7b-instruct-q4_K_M,qwen2.5:3b-instruct-q4_K_M
OLLAMA_EMBED_MODELS=bge-m3

# Qdrant
QDRANT_API_KEY=change-me

# Reranker (Hugging Face TEI). Model pulled on first start (~1.2 GB).
TEI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Langfuse v2 — RAG / LLM observability. Single web container + dedicated Postgres.
# Generate secrets with: openssl rand -base64 32
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=change-me
LANGFUSE_DB_NAME=langfuse
LANGFUSE_NEXTAUTH_SECRET=change-me-base64
LANGFUSE_SALT=change-me-base64

# Open WebUI — chat UI on top of Ollama.
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me-hex
